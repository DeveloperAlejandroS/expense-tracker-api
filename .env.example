# Lista separada por comas de orígenes permitidos por CORS (ej. tu frontend
# desplegado + localhost para dev). Si se omite, CORS acepta cualquier
# origen -- configurala en producción.
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_FRONTEND_DOMAIN